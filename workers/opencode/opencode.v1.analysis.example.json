{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/YOUR_LOCAL_MODEL_ID",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "YOUR_LOCAL_MODEL_ID": {
          "name": "Approved local model"
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "deny",
    "bash": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
